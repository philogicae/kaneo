{
  "name": "@kaneo/api",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "vp run compile",
    "lint": "vp check .",
    "typecheck": "vp run check:types",
    "test": "vp run test:run",
    "test:coverage": "vp run test:coverage:run",
    "test:unit": "vp run test:run",
    "test:integration": "vp run test:integration:run",
    "test:watch": "vp test --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed:user-data": "tsx scripts/seed-user-data.ts",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "~1.6.30",
    "@hono/node-server": "^2.1.0",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-openapi": "^1.6.1",
    "@kaneo/email": "workspace:*",
    "@kaneo/permissions": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@scalar/hono-api-reference": "0.12.1",
    "bcryptjs": "^3.0.2",
    "better-auth": "~1.6.30",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "marked": "17.0.6",
    "octokit": "^5.0.5",
    "valibot": "^1.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vitest": "catalog:",
    "vite-plus": "catalog:",
    "vite": "catalog:"
  }
}
