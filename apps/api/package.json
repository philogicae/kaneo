{
  "dependencies": {
    "@better-auth/api-key": "~1.7.12",
    "@hono/node-server": "^2.1.5",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-openapi": "^1.6.3",
    "@kaneo/email": "workspace:*",
    "@kaneo/importers": "workspace:*",
    "@kaneo/permissions": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@scalar/hono-api-reference": "0.12.14",
    "bcryptjs": "^3.0.3",
    "better-auth": "~1.7.12",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "marked": "18.1.1",
    "octokit": "^5.0.5",
    "undici": "^8.12.3",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "name": "@kaneo/api",
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "private": true,
  "scripts": {
    "build": "vp run compile",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:user-data": "tsx scripts/seed-user-data.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx watch src/index.ts",
    "lint": "vp check .",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "test": "vp run test:run",
    "test:coverage": "vp run test:coverage:run",
    "test:integration": "vp run test:integration:run",
    "test:unit": "vp run test:run",
    "test:watch": "vp test --config vitest.config.ts",
    "typecheck": "vp run check:types"
  },
  "type": "module",
  "types": "./src/index.ts"
}
