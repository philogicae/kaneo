{
	"$schema": "https://mintlify.com/docs.json",
	"appearance": {
		"default": "dark"
	},
	"colors": {
		"primary": "#111111",
		"light": "#fafafa",
		"dark": "#1f1f1f"
	},
	"contextual": {
		"options": ["copy", "view", "chatgpt", "claude", "cursor"]
	},
	"favicon": "/favicon.svg",
	"fonts": {
		"family": "Geist Variable",
		"source": "https://kaneo.app/docs/fonts/geist.woff2",
		"format": "woff2"
	},
	"footer": {
		"socials": {
			"website": "https://kaneo.app",
			"github": "https://github.com/usekaneo/kaneo",
			"x": "https://x.com/usekaneo"
		}
	},
	"icons": {
		"library": "lucide"
	},
	"integrations": {
		"plausible": {
			"domain": "kaneo.app",
			"server": "plausible.kaneo.app"
		}
	},
	"logo": {
		"light": "/logo/dark.svg",
		"dark": "/logo/light.svg"
	},
	"name": "Kaneo",
	"navbar": {
		"links": [
			{
				"label": "GitHub",
				"href": "https://github.com/usekaneo/kaneo"
			}
		],
		"primary": {
			"href": "https://kaneo.app",
			"label": "Open Kaneo",
			"type": "button"
		}
	},
	"navigation": {
		"global": {
			"anchors": [
				{
					"anchor": "Website",
					"href": "https://kaneo.app",
					"icon": "globe"
				},
				{
					"anchor": "GitHub",
					"href": "https://github.com/usekaneo/kaneo",
					"icon": "github"
				}
			]
		},
		"tabs": [
			{
				"tab": "Guides",
				"groups": [
					{
						"group": "Overview",
						"pages": ["index", "core/index"]
					},
					{
						"group": "Functional Guides",
						"pages": [
							"core/functional/index",
							"core/functional/create-workspace-and-project",
							"core/functional/plan-and-execute-tasks",
							"core/functional/backlog-planning",
							"core/functional/dashboard-and-analytics",
							"core/functional/appointments-calendar-gantt",
							"core/functional/recurrence-and-reminders",
							"core/functional/custom-fields",
							"core/functional/search-and-command-palette",
							"core/functional/collaborate-with-team",
							"core/functional/teams-and-scoped-access",
							"core/functional/configure-workflows",
							"core/functional/account-notifications",
							"core/functional/manage-your-account",
							"core/functional/personalize-your-workspace",
							"core/functional/manage-workspace-labels"
						]
					},
					{
						"group": "Installation",
						"pages": [
							"core/installation/index",
							"core/installation/docker-compose",
							"core/installation/environment-variables",
							"core/installation/start-services",
							"core/installation/object-storage-and-image-uploads"
						]
					},
					{
						"group": "GitHub Integration",
						"pages": [
							"core/integrations/github/setup",
							"core/integrations/github/configuration",
							"core/integrations/github/troubleshooting"
						]
					},
					{
						"group": "Gitea Integration",
						"pages": ["core/integrations/gitea/setup"]
					},
					{
						"group": "Integrations",
						"pages": [
							"core/integrations/mcp",
							"core/integrations/mcp-stateless",
							"core/integrations/agent-skill",
							"core/integrations/discord",
							"core/integrations/slack",
							"core/integrations/telegram",
							"core/integrations/mattermost",
							"core/integrations/outgoing-webhooks"
						]
					},
					{
						"group": "Authentication Providers",
						"pages": [
							"core/social-providers/github",
							"core/social-providers/google",
							"core/social-providers/discord",
							"core/social-providers/custom-oauth"
						]
					},
					{
						"group": "Deployment & Operations",
						"pages": ["core/reverse-proxy/nginx", "core/deployments/railway"]
					},
					{
						"group": "Migration",
						"pages": ["core/migrations/from-planka"]
					}
				]
			},
			{
				"tab": "API Reference",
				"openapi": "openapi.json"
			}
		]
	},
	"redirects": [
		{
			"source": "/core/guide/migrating-from-v1",
			"destination": "/core/installation/environment-variables"
		},
		{
			"source": "/core/integrations/cli",
			"destination": "/cli"
		},
		{
			"source": "/core/integrations/cli-commands",
			"destination": "/cli/reference"
		}
	],
	"seo": {
		"indexing": "all",
		"metatags": {
			"og:site_name": "Kaneo Docs",
			"og:type": "website",
			"og:image": "https://kaneo.app/images/hero.png",
			"twitter:card": "summary_large_image",
			"twitter:site": "@usekaneo",
			"twitter:image": "https://kaneo.app/images/hero.png"
		}
	},
	"styling": {
		"codeblocks": {
			"theme": {
				"light": "min-light",
				"dark": "min-dark"
			}
		}
	},
	"theme": "almond"
}
