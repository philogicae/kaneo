# General URLs
KANEO_CLIENT_URL=http://localhost:5173
# KANEO_API_URL=http://localhost:1337      # optional - defaults to KANEO_CLIENT_URL/api
# KANEO_INTERNAL_API_URL=http://127.0.0.1:1337 # optional - internal MCP tool requests only
# CORS_ORIGINS=                            # optional - comma-separated; defaults to KANEO_CLIENT_URL

# Database (defaults to ./data/kaneo.db, next to the test database)
# DATABASE_PATH=./data/kaneo.db

# Uploaded assets (default: assets/ next to the database file, inside the data volume)
# STORAGE_PATH=./data/assets
# STORAGE_KEY_PREFIX=
# STORAGE_MAX_IMAGE_UPLOAD_BYTES=10485760

# Docker Compose host data directory for the database files
# KANEO_DATA_PATH=./data

# Authentication
# Generate with: openssl rand -hex 32
# If unset, a random secret is generated at startup (sessions won't survive restarts)
AUTH_SECRET=

# Access
DISABLE_GUEST_ACCESS=false # Change after admin creation
DISABLE_REGISTRATION=false # Change after admin creation

# GitHub SSO (Sign in with GitHub, OAuth App)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Legacy fallback for SSO (used only if GITHUB_OAUTH_* are unset)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub integration (GitHub App: repository sync, webhooks)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=
# When SMTP is configured, sign-in uses email verification codes by default.
# Set to true to use email/password sign-in instead (invitations still use SMTP).
#DISABLE_EMAIL_OTP_SIGN_IN=false

# TypeSafe AI / Jev (System One) - optional
# When set, global search results are reranked and filtered by Jev, and task
# creation gets an automatic priority plus semantic labels (branch:/machine:
# labels are never picked automatically).
#TYPESAFE_API_KEY=
#TYPESAFE_BASE_URL=https://api.typesafe.ai      # API root (optional)
# Optional tuning (defaults shown):
#KANEO_JEV_MODEL=jev-latest                     # pin a version like jev-1.13.0 for stable thresholds
#KANEO_JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
#KANEO_JEV_MIN_RATIO=0.5                        # keep search results at or above this relevance (0-1)
#KANEO_JEV_LABEL_THRESHOLD=0.5                  # minimum probability for an auto-applied task label (0-1)
#KANEO_JEV_MAX_REQUEST_TOKENS=30000             # state + questions per request (API: 32k for state + longest question)
#KANEO_JEV_TIMEOUT_MS=10000
#KANEO_JEV_MAX_RETRIES=2
