{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": [
		"CORS_ORIGINS",
		"GITHUB_APP_NAME",
		"GITHUB_PRIVATE_KEY",
		"GITHUB_PRIVATE_KEY_BASE64",
		"KANEO_ALLOW_PRIVATE_WEBHOOK_DESTINATIONS",
		"KANEO_API_URL",
		"KANEO_CLIENT_URL",
		"STORAGE_KEY_PREFIX",
		"STORAGE_MAX_IMAGE_UPLOAD_BYTES",
		"STORAGE_PATH",
		"TURNSTILE_SECRET_KEY"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},

		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"lint": {
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"]
		},
		"test:coverage": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"]
		},
		"test:integration": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": ["coverage/**"],
			"env": [
				"DATABASE_PATH",
				"STORAGE_PATH",
				"STORAGE_KEY_PREFIX",
				"STORAGE_MAX_IMAGE_UPLOAD_BYTES"
			]
		}
	}
}
